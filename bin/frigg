#!/usr/bin/env bash
# frigg: the command-line side of the Frigg store for Omarchy.
#
#   frigg store        open the store window
#   frigg              browse the store in the terminal
#   frigg list         list the apps
#   frigg info ID      show one app
#   frigg install ID   pay the developer (if the app has a price), download the
#                      app from the developer, and run the developer's installer
#
# The catalog is a set of small JSON manifests. Payment goes straight to the
# developer, by Lightning or on-chain Bitcoin: Frigg never holds money.
set -euo pipefail

FRIGG_URL="${FRIGG_URL:-https://raw.githubusercontent.com/hasky00/Frigg/main}"
FRIGG_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/frigg"
LNURL_SCHEME="${FRIGG_LNURL_SCHEME:-https}"   # tests point this at a local http server
PAY_TIMEOUT="${FRIGG_PAY_TIMEOUT:-600}"       # seconds to wait for a payment
MEMPOOL_API="${FRIGG_MEMPOOL_API:-https://mempool.space/api}"  # where on-chain payments are looked up

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"

die() { echo "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "frigg needs '$1'. On Omarchy: omarchy-pkg-add $1"; }
need curl
need jq

catalog() { curl -fsSL "$FRIGG_URL/apps/index.json" || die "Could not reach the Frigg catalog at $FRIGG_URL"; }
manifest() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "'$1' is not a valid app id."
  curl -fsSL "$FRIGG_URL/apps/$1.json" 2>/dev/null || die "No app called '$1' in the store. Try: frigg list"
}

price_label() { jq -r 'if (.price_sats // 0) > 0 then "\(.price_sats) sats" else "free" end'; }

cmd_list() {
  catalog | jq -r '.[] | [.id, .name, (if (.price_sats // 0) > 0 then "\(.price_sats) sats" else "free" end), (.tagline // "")] | @tsv' \
    | awk -F'\t' '{ printf "%-14s %-14s %-12s %s\n", $1, $2, $3, $4 }'
}

cmd_info() {
  [[ -n "${1:-}" ]] || die "Usage: frigg info ID"
  local app; app="$(manifest "$1")"
  jq -r '"\(.name)\(if .version then " " + .version else "" end)\nby \(.developer)\n\n\(.description // "No description yet.")\n"' <<<"$app"
  jq -r '(.features // [])[] | "  - " + .' <<<"$app"
  echo
  echo "Price:  $(price_label <<<"$app")"
  jq -r 'if .lightning_address then "Paid to: " + .lightning_address else empty end' <<<"$app"
  jq -r 'if .bitcoin_address then "On-chain: " + .bitcoin_address else empty end' <<<"$app"
  jq -r 'if .source.repo then "Source: " + .source.repo else empty end' <<<"$app"
}

# ---- payment ----------------------------------------------------------------
# LNURL-pay: ask the developer's Lightning address for an invoice, show it, and
# (when the wallet provider supports it) watch until it is settled.

receipt_file() { echo "$FRIGG_HOME/receipts/$1.json"; }

# A code a phone can actually read. In the terminal: true black on true white
# (the theme's own colours wash it out) with a white border, and only when the
# window is big enough to show all of it, because a code cut off at the edge
# cannot be scanned. It is also opened as a picture when the desktop can.
show_qr() {
  command -v qrencode >/dev/null || return 0
  local data="$1" plain width rows cols lines fits=0 shown=0

  plain="$(qrencode -t UTF8 -m 2 "$data" 2>/dev/null || true)"
  if [[ -n "$plain" ]]; then
    width="$(head -n 1 <<<"$plain" | wc -m)"
    rows="$(wc -l <<<"$plain")"
    cols="$(tput cols 2>/dev/null || echo 80)"
    lines="$(tput lines 2>/dev/null || echo 24)"
    (( width <= cols && rows + 4 <= lines )) && fits=1
  fi

  local picture="${XDG_RUNTIME_DIR:-/tmp}/frigg-pay.png"
  if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v xdg-open >/dev/null \
     && qrencode -s 10 -m 4 -o "$picture" "$data" 2>/dev/null; then
    (setsid xdg-open "$picture" >/dev/null 2>&1 &)
    shown=1
  fi

  if (( fits )); then
    qrencode -t ANSI256UTF8 -m 2 "$data" || true
    (( shown )) && echo "The same code also opened as a picture, if that is easier to scan."
  elif (( shown )); then
    echo "This window is too small for the code, so it opened as a picture. Scan that."
  else
    echo "This window is too small to show the code. Make it bigger (Super + F) and run frigg again, or copy the invoice below into your wallet."
  fi
  return 0
}

pay_lightning() {
  local id="$1" name="$2" sats="$3" address="$4"
  local user="${address%@*}" domain="${address#*@}"
  [[ "$address" == *@* && -n "$user" && -n "$domain" ]] || { echo "$name has no valid Lightning address." >&2; return 1; }

  local meta callback min max
  meta="$(curl -fsSL "$LNURL_SCHEME://$domain/.well-known/lnurlp/$user")" || { echo "Could not reach $address to ask for an invoice." >&2; return 1; }
  callback="$(jq -r '.callback // empty' <<<"$meta")"
  min="$(jq -r '.minSendable // 0' <<<"$meta")"
  max="$(jq -r '.maxSendable // 0' <<<"$meta")"
  [[ -n "$callback" ]] || { echo "$address did not answer like a Lightning address." >&2; return 1; }

  local msats=$(( sats * 1000 ))
  (( msats >= min && (max == 0 || msats <= max) )) || { echo "$address does not accept a payment of $sats sats." >&2; return 1; }

  local sep="?"; [[ "$callback" == *\?* ]] && sep="&"
  local reply invoice verify
  # No -f here: when a wallet refuses, its answer says why, and the buyer should see it.
  reply="$(curl -sSL "${callback}${sep}amount=${msats}")" || { echo "Could not reach $address to get an invoice." >&2; return 1; }
  invoice="$(jq -r '.pr // empty' <<<"$reply")"
  verify="$(jq -r '.verify // empty' <<<"$reply")"
  if [[ -z "$invoice" ]]; then
    local reason
    reason="$(jq -r '.reason // .message // .error // empty' <<<"$reply" 2>/dev/null || true)"
    echo "$address could not make a Lightning invoice. The wallet said: ${reason:-nothing useful}" >&2
    return 1
  fi

  echo
  echo "Pay $sats sats to $address for $name."
  echo "The money goes straight to the developer. Frigg takes nothing."
  echo
  show_qr "LIGHTNING:${invoice^^}"   # upper case makes a much less dense code; wallets read both
  echo "$invoice"
  echo

  if [[ -n "$verify" ]]; then
    echo "Waiting for the payment (Ctrl-C to cancel)..."
    local waited=0 state
    while (( waited < PAY_TIMEOUT )); do
      state="$(curl -fsSL "$verify" 2>/dev/null || true)"
      if [[ -n "$state" ]] && jq -e '.settled == true' <<<"$state" >/dev/null 2>&1; then
        mkdir -p "$FRIGG_HOME/receipts"
        jq -n --arg id "$id" --arg to "$address" --argjson sats "$sats" \
              --arg preimage "$(jq -r '.preimage // empty' <<<"$state")" --arg at "$(date -u +%FT%TZ)" \
              '{app: $id, paid_to: $to, sats: $sats, preimage: $preimage, paid_at: $at}' > "$(receipt_file "$id")"
        echo "Paid. Thank you for supporting $name."
        return 0
      fi
      sleep 2; waited=$(( waited + 2 ))
    done
    die "No payment arrived in time. Nothing was installed."
  fi

  # No way to check with this wallet provider, so trust the buyer.
  read -r -p "This wallet cannot confirm payments to Frigg. Press Enter once you have paid, or Ctrl-C to cancel. " _
  mkdir -p "$FRIGG_HOME/receipts"
  jq -n --arg id "$id" --arg to "$address" --argjson sats "$sats" --arg at "$(date -u +%FT%TZ)" \
        '{app: $id, paid_to: $to, sats: $sats, preimage: "", confirmed_by: "buyer", paid_at: $at}' > "$(receipt_file "$id")"
}

# On-chain: show the developer's Bitcoin address with the amount, then watch the
# public mempool for a new payment to it. Slower than Lightning, and the buyer's
# wallet adds a network fee, but it works from any Bitcoin wallet.

pay_onchain() {
  local id="$1" name="$2" sats="$3" address="$4"
  [[ "$address" =~ ^(bc1[a-z0-9]{20,90}|[13][a-km-zA-HJ-NP-Z1-9]{25,39})$ ]] || { echo "$name has no valid Bitcoin address." >&2; return 1; }

  # Remember what has already been paid to this address, so only a new payment counts.
  local before
  before="$(curl -fsSL "$MEMPOOL_API/address/$address/txs" | jq -c '[.[].txid]')" || { echo "Could not look up $address to watch for your payment." >&2; return 1; }

  local btc; btc="$(printf '%d.%08d' $(( sats / 100000000 )) $(( sats % 100000000 )))"
  local uri="bitcoin:$address?amount=$btc"

  echo
  echo "Pay $sats sats ($btc BTC) to the developer of $name, on-chain."
  echo "The money goes straight to the developer. Frigg takes nothing."
  echo "Your wallet adds a network fee on top."
  echo
  show_qr "$uri"
  echo "$address"
  echo "Amount: $sats sats"
  echo
  echo "Waiting to see your payment on the network (Ctrl-C to cancel)..."

  local waited=0 txs txid
  while (( waited < PAY_TIMEOUT )); do
    txs="$(curl -fsSL "$MEMPOOL_API/address/$address/txs" 2>/dev/null || true)"
    if [[ -n "$txs" ]]; then
      txid="$(jq -r --arg a "$address" --argjson sats "$sats" --argjson before "$before" \
        '[.[] | select(.txid as $t | ($before | index($t)) | not)
              | select(([.vout[] | select(.scriptpubkey_address == $a) | .value] | add // 0) >= $sats) | .txid][0] // empty' <<<"$txs" 2>/dev/null || true)"
      if [[ -n "$txid" ]]; then
        mkdir -p "$FRIGG_HOME/receipts"
        jq -n --arg id "$id" --arg to "$address" --argjson sats "$sats" --arg txid "$txid" --arg at "$(date -u +%FT%TZ)" \
              '{app: $id, paid_to: $to, sats: $sats, txid: $txid, paid_at: $at}' > "$(receipt_file "$id")"
        echo "Payment seen. Thank you for supporting $name."
        return 0
      fi
    fi
    sleep 5; waited=$(( waited + 5 ))
  done
  echo "No payment showed up in time." >&2
  return 1
}

# Lightning first, because it is instant and nearly free. On-chain if the
# developer has no working Lightning address.
pay() {
  local id="$1" name="$2" sats="$3" lightning="$4" bitcoin="$5"
  if [[ -n "$lightning" ]]; then
    pay_lightning "$id" "$name" "$sats" "$lightning" && return 0
    [[ -n "$bitcoin" ]] && echo "Switching to an on-chain Bitcoin payment." >&2
  fi
  if [[ -n "$bitcoin" ]]; then
    pay_onchain "$id" "$name" "$sats" "$bitcoin" && return 0
  fi
  die "$name could not be paid for, so nothing was installed."
}

# ---- install ----------------------------------------------------------------

cmd_install() {
  [[ -n "${1:-}" ]] || die "Usage: frigg install ID"
  need git
  local id="$1" app name repo branch subdir script price address bitcoin
  app="$(manifest "$id")"
  name="$(jq -r '.name' <<<"$app")"
  repo="$(jq -r '.source.repo // empty' <<<"$app")"
  branch="$(jq -r '.source.branch // empty' <<<"$app")"
  subdir="$(jq -r '.source.subdir // empty' <<<"$app")"
  script="$(jq -r '.source.install // "install.sh"' <<<"$app")"
  price="$(jq -r '.price_sats // 0' <<<"$app")"
  address="$(jq -r '.lightning_address // empty' <<<"$app")"
  bitcoin="$(jq -r '.bitcoin_address // empty' <<<"$app")"

  [[ "$repo" == https://* ]] || die "$name has no source to install from yet."
  [[ "$subdir" != *..* && "$script" != *..* && "$script" != /* && "$subdir" != /* ]] || die "$name has an unsafe install path in its listing."

  if (( price > 0 )); then
    if [[ -f "$(receipt_file "$id")" ]]; then
      echo "You already paid for $name. Not charging again."
    else
      pay "$id" "$name" "$price" "$address" "$bitcoin"
    fi
  fi

  local dest="$FRIGG_HOME/apps/$id"
  if [[ -d "$dest/.git" ]]; then
    echo "Updating $name..."
    git -C "$dest" pull --ff-only --quiet
  else
    echo "Downloading $name from $repo..."
    mkdir -p "$(dirname "$dest")"
    git clone --quiet --depth 1 ${branch:+--branch "$branch"} "$repo" "$dest"
  fi

  local installer="$dest/${subdir:+$subdir/}$script"
  [[ -f "$installer" ]] || die "No installer found at $installer"

  # Frigg does not review code. Say so, and let the buyer look first.
  echo
  echo "$name comes straight from its developer. Frigg has not reviewed it."
  echo "The installer about to run is: $installer"
  local answer
  read -r -p "Run it now? [y/N] " answer
  if [[ ! "$answer" =~ ^[Yy]$ ]]; then
    echo "Nothing was installed. The files are in $dest if you want to read them."
    return 0
  fi

  bash "$installer"
}

# ---- browse -----------------------------------------------------------------

cmd_browse() {
  need fzf
  local pick id
  pick="$(cmd_list | fzf --prompt 'Frigg > ' --header 'Enter: install   Esc: leave' \
            --preview "$SELF info {1}" --preview-window 'down:60%:wrap' --no-multi || true)"
  [[ -n "$pick" ]] || return 0
  id="${pick%% *}"
  cmd_install "$id"
}

# ---- hand-over from the store window ----------------------------------------
# The store's Buy button is a link like frigg://install/hasky-shelf. The desktop
# passes it here; we open a terminal for the payment and the install.

run_in_terminal() {
  if command -v omarchy-launch-floating-terminal-with-presentation >/dev/null; then
    omarchy-launch-floating-terminal-with-presentation "$@"
  elif command -v xdg-terminal-exec >/dev/null; then
    xdg-terminal-exec -e "$@"
  else
    "$@"
  fi
}

cmd_open() {
  local url="${1:-}" id
  [[ "$url" =~ ^frigg://install/([a-z0-9][a-z0-9-]*)/?$ ]] || die "Frigg does not understand this link: $url"
  id="${BASH_REMATCH[1]}"
  run_in_terminal "$SELF" install "$id"
}

cmd_store() {
  local page="${FRIGG_STORE_URL:-https://hasky00.github.io/Frigg/store.html}"
  if command -v omarchy-launch-webapp >/dev/null; then
    omarchy-launch-webapp "$page"
  else
    xdg-open "$page"
  fi
}

case "${1:-}" in
  "")       if [[ -t 0 && -t 1 ]]; then cmd_browse; else cmd_list; fi ;;
  list)     cmd_list ;;
  info)     cmd_info "${2:-}" ;;
  install)  cmd_install "${2:-}" ;;
  open)     cmd_open "${2:-}" ;;
  store)    cmd_store ;;
  -h|--help|help) sed -n '2,11p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *)        die "Usage: frigg [store | list | info ID | install ID]" ;;
esac
